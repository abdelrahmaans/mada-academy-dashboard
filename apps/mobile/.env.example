# Android Emulator reaches the host machine through 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4191/api/v1

# For iOS Simulator, use http://127.0.0.1:4191/api/v1 instead.
# For a physical device, use the development machine's LAN IP and ensure
# the API listens on an address reachable from the device.
# Never put passwords, JWT keys, or server secrets in EXPO_PUBLIC_* values.
