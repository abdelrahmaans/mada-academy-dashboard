flowchart TB
  %% Mada Academy role / permission / endpoint distribution
  subgraph ROLES[الأدوار R00–R09]
    R00["R00<br/>Platform Admin<br/>نطاق المنصة"]
    R01["R01<br/>Academy Owner<br/>نطاق الأكاديمية"]
    R02["R02<br/>Branch Manager<br/>نطاق الفرع"]
    R03["R03<br/>Head Instructors<br/>الفرع + المجموعات المسندة"]
    R04["R04<br/>Instructor<br/>الجلسات والطلاب المعيّنون"]
    R05["R05<br/>Secretary<br/>عمليات الفرع"]
    R06["R06<br/>Accountant<br/>مالية الفرع"]
    R07["R07<br/>Marketing Manager<br/>تسويق الفرع"]
    R08["R08<br/>Parent<br/>الأطفال المرتبطون"]
    R09["R09<br/>Student<br/>السجل المرتبط"]
  end

  subgraph IDENTITY[الهوية والإدارة]
    AUTH["Auth & Session<br/>/auth/* · /me"]
    PLATFORM["Platform Admin APIs<br/>/platform/*<br/>platform.read"]
    ACADEMY["Academy Admin APIs<br/>/academy/roles<br/>/academy/members<br/>/academy/branches<br/>/academy/classrooms<br/>roles.manage · staff.invite"]
    LINKS["Consumer Link APIs<br/>/students/{id}/consumer-*<br/>staff link management"]
  end

  subgraph OPERATIONS[التشغيل والجلسات]
    DASH["Dashboard & Scope<br/>/dashboard/summary<br/>/tenants/{id}/scope-check"]
    STUDENTS["Students & Sessions<br/>/students · /sessions<br/>sessions.read · students.read"]
    ATTENDANCE["Attendance<br/>/sessions/{id}/attendance<br/>attendance.read/write"]
    SCHEDULING["Scheduling<br/>/scheduling/course-templates<br/>/scheduling/groups<br/>/scheduling/instructors<br/>/scheduling/sessions"]
    APPROVALS["Approvals & Substitution<br/>/scheduling/approvals<br/>/session-requests<br/>/substitution-requests"]
    SUPERVISION["Group Supervision<br/>/supervision/*<br/>assignment + branch scope"]
  end

  subgraph EVALUATIONS[التقييمات والتنبيهات]
    EVALWRITE["Evaluation Authoring<br/>/scheduling/sessions/{id}/evaluations<br/>evaluations.write"]
    EVALREVIEW["Evaluation Review<br/>/scheduling/evaluation-reviews<br/>/evaluation-status-summary<br/>evaluations.review"]
    NOTIFY["Notifications<br/>/scheduling/notifications<br/>actor/recipient scope"]
  end

  subgraph FINANCE[المالية والتقارير]
    INVOICES["Invoices & Payments<br/>/finance/invoices<br/>/finance/payments/*"]
    EXPENSES["Expenses<br/>/finance/expenses/*"]
    FINREPORTS["Finance Reports<br/>/finance/reports/*"]
    REPORTS["Operational & Executive Reports<br/>/reports/* · /academy/executive-*"]
  end

  subgraph CONSUMER[بوابات المستهلك]
    PORTAL["Consumer Portal<br/>/consumer/me/students<br/>/consumer/me/sessions<br/>published evaluations only"]
    CINVOICES["Consumer Invoices<br/>/consumer/invoices"]
  end

  R00 --> AUTH
