  CONFLICT["Contract gap:<br/>R03 catalog says attendance.write,<br/>but backend CanWriteAttendance = R02/R04"]
  SECURITY["Backend authoritative:<br/>JWT tenant/branch + linked records +<br/>supervision assignments + publication rules"]

  EVALREVIEW -.-> SECURITY
  PORTAL -.-> SECURITY
  ATTENDANCE -.-> CONFLICT

  classDef role fill:#183b56,color:#fff,stroke:#0b2538,stroke-width:2px;
