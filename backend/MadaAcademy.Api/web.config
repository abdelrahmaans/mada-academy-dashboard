<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Access-Control-Allow-Origin" value="*" />
          <add name="Access-Control-Allow-Headers" value="*" />
          <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS, PATCH" />
        </customHeaders>
      </httpProtocol>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\MadaAcademy.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
          <environmentVariable name="MADA_DATABASE_MODE" value="memory" />
          <environmentVariable name="MADA_SEED_DEMO_DATA" value="true" />
          <environmentVariable name="MADA_ENABLE_DEV_ENDPOINTS" value="true" />
          <environmentVariable name="MADA_JWT_SIGNING_KEY" value="development-only-mada-jwt-key-change-before-production-2026" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
