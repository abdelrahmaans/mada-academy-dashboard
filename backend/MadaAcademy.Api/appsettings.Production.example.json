{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MADA_DATABASE_MODE": "postgres",
  "ConnectionStrings": {
    "Default": "Host=YOUR_POSTGRES_HOST;Port=5432;Database=mada_academy;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "MADA_APPLY_MIGRATIONS": "true",
  "MADA_SEED_DEMO_DATA": "false",
  "MADA_ENABLE_DEV_ENDPOINTS": "false",
  "MADA_FRONTEND_URL": "https://mada-academy-dashboard.vercel.app",
  "MADA_CORS_ORIGINS": "https://mada-academy-dashboard.vercel.app",
  "MADA_JWT_SIGNING_KEY": "REPLACE_WITH_AT_LEAST_32_CHARS_HIGH_ENTROPY_SECRET",
  "MADA_RATE_LIMIT_MODE": "single-instance",
  "MADA_RATE_LIMIT_EXPECTED_INSTANCES": "1",
  "MADA_TRUSTED_PROXIES": "",
  "Mada": {
    "PrivateStorageMode": "supabase",
    "PrivateStorageMaxBytes": 10485760
  },
  "Supabase": {
    "Url": "https://YOUR_PROJECT.supabase.co",
    "ServiceRoleKey": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY",
    "StorageBucket": "mada-private-evidence"
  },
  "AuthenticationSecurity": {
    "LoginPermitLimit": 20,
    "LoginWindowSeconds": 60,
    "SensitivePermitLimit": 30,
    "SensitiveWindowSeconds": 60,
    "ConsumerLookupPermitLimit": 60,
    "ConsumerLookupWindowSeconds": 60
  }
}
