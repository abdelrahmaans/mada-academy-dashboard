# PostgreSQL connection string for local/deployed backend
DATABASE_URL=Host=localhost;Port=5432;Database=mada_academy;Username=postgres;Password=change-me

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:4191

# Required outside Development; use a random secret >= 32 characters
MADA_JWT_SIGNING_KEY=replace-with-a-long-random-production-secret

# Optional QA/development OTP only
MADA_AUTH_TEST_OTP=000000

# Use memory only for local integration tests; production must use PostgreSQL
# MADA_DATABASE_MODE=memory

# Private payment evidence storage; never expose this directory as static files.
# Use a persistent volume in staging/production.
# MADA_PRIVATE_STORAGE_ROOT=/var/lib/mada/private-storage
# Optional object limit in bytes; defaults to 10 MiB and must stay outside wwwroot.
# MADA_PRIVATE_STORAGE_MAX_BYTES=10485760

# Evidence storage mode: local is Development-only; production defaults to disabled.
# MADA_PRIVATE_STORAGE_MODE=disabled
# For Supabase private Storage (server-side only; never expose the service-role key to the frontend):
# MADA_PRIVATE_STORAGE_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# SUPABASE_STORAGE_BUCKET=private-evidence
