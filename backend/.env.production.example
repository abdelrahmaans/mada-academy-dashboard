# Copy into the API host's secret/environment manager. Never commit real values.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
MADA_FRONTEND_URL=https://<frontend-host>
DATABASE_URL=Host=<postgres-host>;Port=5432;Database=<database>;Username=<app-user>;Password=<secret>
MADA_JWT_SIGNING_KEY=<random-secret-at-least-32-characters>

# Required private evidence storage configuration.
MADA_PRIVATE_STORAGE_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret>
SUPABASE_STORAGE_BUCKET=private-evidence
MADA_PRIVATE_STORAGE_MAX_BYTES=10485760

# Production must not use the InMemory database or development OTP sender.
# Do not set MADA_DATABASE_MODE=memory.
# Do not expose SUPABASE_SERVICE_ROLE_KEY to VITE_* or the browser.
