# React browser API endpoint
# Local development:
VITE_API_URL=http://127.0.0.1:4191/api/v1

# For a public preview, set this to the public HTTPS API URL before starting Vite.
# VITE_API_URL=https://<api-host>/api/v1

# ASP.NET API: absolute frontend URL used in consumer invitation messages.
# Development defaults to http://localhost:5173; production requires this value.
# MADA_FRONTEND_URL=https://<app-host>

# Comma-separated IP addresses of reverse proxies allowed to provide
# X-Forwarded-For/X-Forwarded-Proto. Leave unset when the API is directly exposed;
# never trust arbitrary forwarded headers. Example: MADA_TRUSTED_PROXIES=10.0.0.10
# MADA_TRUSTED_PROXIES=10.0.0.10,10.0.0.11

# Optional ASP.NET authentication/rate-limit tuning. Defaults are fail-safe and
# are bounded to positive values by the API.
# AuthenticationSecurity__LoginPermitLimit=20
# AuthenticationSecurity__LoginWindowSeconds=60
# AuthenticationSecurity__SensitivePermitLimit=30
# AuthenticationSecurity__SensitiveWindowSeconds=60
# AuthenticationSecurity__ConsumerLookupPermitLimit=60
# AuthenticationSecurity__ConsumerLookupWindowSeconds=60

# Optional Umami analytics. The script is not loaded unless both values exist.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=<website-id>
