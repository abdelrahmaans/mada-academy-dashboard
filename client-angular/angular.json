{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "mada-academy-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "mada",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["src/styles.scss"],
            "outputPath": "dist/mada-academy-angular"
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }], "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "host": "0.0.0.0", "port": 4300, "allowedHosts": [".manus.computer", ".manuspre.computer", ".manus-asia.computer", ".manuscomputer.ai", ".manusvm.computer"] }, "configurations": { "production": { "buildTarget": "mada-academy-angular:build:production" }, "development": { "buildTarget": "mada-academy-angular:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": { "analytics": false }
}
